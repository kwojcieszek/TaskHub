<Project>

  <!--
    Release version shared by every backend assembly: the release date and the number of the release on that day,
    e.g. 2026.10.28.1. It is read from version.json; raise it there before each release.
  -->
  <PropertyGroup>
    <ReleaseVersionFile>$(MSBuildThisFileDirectory)version.json</ReleaseVersionFile>
    <ReleaseVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ReleaseVersionFile)')), '"version"\s*:\s*"([0-9.]+)"').Groups[1].Value)</ReleaseVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(ReleaseVersion)</Version>
    <AssemblyVersion>$(ReleaseVersion)</AssemblyVersion>
    <FileVersion>$(ReleaseVersion)</FileVersion>
    <InformationalVersion>$(ReleaseVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
